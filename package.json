{
  "name": "kit-web",
  "version": "0.1.0",
  "description": "Generic multi-domain (or single-domain) site utilities for TanStack Start — llms.txt, sitemap.xml, robots.txt, head meta, and site resolution.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxtzfr/kit-web.git"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-start": "*"
  },
  "devDependencies": {
    "@tanstack/react-start": "^1.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
