{
  "name": "@lxtzfr/my-stack-tanstack",
  "version": "0.6.0",
  "description": "Generic multi-domain (or single-domain) site utilities for TanStack Start — llms.txt, sitemap.xml, robots.txt, head meta, site resolution, a dev-only site switcher, plus process-wide plumbing (event bus, data dir, Prisma/SQLite bootstrap).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./siteResolver": {
      "types": "./dist/siteResolver.d.ts",
      "import": "./dist/siteResolver.js"
    },
    "./forwardedOrigin": {
      "types": "./dist/forwardedOrigin.d.ts",
      "import": "./dist/forwardedOrigin.js"
    },
    "./siteConfigServerFn": {
      "types": "./dist/siteConfigServerFn.d.ts",
      "import": "./dist/siteConfigServerFn.js"
    },
    "./llmsTxt": {
      "types": "./dist/llmsTxt.d.ts",
      "import": "./dist/llmsTxt.js"
    },
    "./sitemap": {
      "types": "./dist/sitemap.d.ts",
      "import": "./dist/sitemap.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js"
    },
    "./headMeta": {
      "types": "./dist/headMeta.d.ts",
      "import": "./dist/headMeta.js"
    },
    "./brandHead": {
      "types": "./dist/brandHead.d.ts",
      "import": "./dist/brandHead.js"
    },
    "./globalSingleton": {
      "types": "./dist/globalSingleton.d.ts",
      "import": "./dist/globalSingleton.js"
    },
    "./eventBus": {
      "types": "./dist/eventBus.d.ts",
      "import": "./dist/eventBus.js"
    },
    "./dataDir": {
      "types": "./dist/dataDir.d.ts",
      "import": "./dist/dataDir.js"
    },
    "./prismaSqlite": {
      "types": "./dist/prismaSqlite.d.ts",
      "import": "./dist/prismaSqlite.js"
    },
    "./DevSiteSwitcher": {
      "types": "./dist/DevSiteSwitcher.d.ts",
      "import": "./dist/DevSiteSwitcher.js"
    }
  },
  "files": [
    "dist",
    "conventions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxtzfr/my-stack.git",
    "directory": "tanstack"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-start": "*",
    "@tanstack/react-router": "*",
    "@prisma/adapter-libsql": "*",
    "@mantine/core": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@prisma/adapter-libsql": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@mantine/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/core": "^9.5.0",
    "@prisma/adapter-libsql": "^7.9.1",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
